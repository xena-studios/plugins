{
  "//": "Hangar's POST /api/v1/projects/{slug}/upload `versionUpload` part: VersionUpload in Hangar's OpenAPI (https://hangar.papermc.io/v3/api-docs), with what Hangar checks on the server (backend model/internal/versions/VersionUpload.java and config/hangar/*Config.java's defaults: the version matches projects.versionNameRegex and is at most maxVersionNameLen 32, 1-3 platforms each with at least one version, the description at most pages.maxLen 32000, the channel matches channels.nameRegex and is at most 15). Read 2026-11-27.",
  "type": "object",
  "required": ["channel", "files", "platformDependencies", "version"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[a-zA-Z0-9-_.+]+$" },
    "channel": { "type": "string", "minLength": 1, "maxLength": 15, "pattern": "^[a-zA-Z0-9]+$" },
    "description": { "type": "string", "maxLength": 32000 },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["platforms"],
        "properties": {
          "externalUrl": { "type": "string" },
          "platforms": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/Platform" } }
        }
      }
    },
    "platformDependencies": {
      "type": "object",
      "additionalProperties": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
      "properties": {
        "PAPER": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "WATERFALL": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "VELOCITY": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "pluginDependencies": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "object",
          "properties": {
            "externalUrl": { "type": "string" },
            "name": { "type": "string" },
            "platform": { "$ref": "#/definitions/Platform" },
            "projectId": { "type": "integer" },
            "required": { "type": "boolean" }
          }
        }
      }
    }
  },
  "definitions": {
    "Platform": { "type": "string", "enum": ["PAPER", "WATERFALL", "VELOCITY"] }
  }
}
