# Response headers for plugins.xenastudios.co (Cloudflare Workers reads this file from the build
# output). The build (scripts/postbuild.ts) moves each page's own inline script into a file and
# fills in the placeholder with the hashes of the few inline scripts every page shares (the
# theme and scroll restoration), so nothing else inline can run. Search (Pagefind) runs as
# WebAssembly, hence 'wasm-unsafe-eval'. The site loads nothing from anywhere else.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self' 'wasm-unsafe-eval' __INLINE_SCRIPTS__; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin

# Hashed build files never change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8

# For editors: a manifest or releases file names its schema by this address.
/schemas/*
  Content-Type: application/schema+json; charset=utf-8
  Access-Control-Allow-Origin: *
