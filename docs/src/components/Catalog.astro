---
// The home page: why the plugins are worth installing, then every plugin by category,
// with a search box. All of it from the brand catalog and the build files
// (src/data/plugins.json), so a new plugin shows up here on its own.
import catalog from "../data/plugins.json" with { type: "json" };

const files = import.meta.glob<{ default: ImageMetadata }>("../assets/plugins/*.svg", { eager: true });
const icon = (id: string) => files[`../assets/plugins/${id}.svg`]?.default.src;
const plugins = catalog.plugins;
const folia = plugins.filter((p) => p.folia).length;
const heaviest = Math.max(...plugins.map((p) => p.jarBudgetKb));
// Blurbs are plain text with `code` spans, as in the brand repo.
const html = (text: string) => text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/`([^`]+)`/g, "<code>$1</code>");
const count = ["no", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten", "eleven", "twelve"][plugins.length] ?? String(plugins.length);

const reasons = [
  {
    title: "Light enough to forget",
    text: `Every jar is under ${heaviest} KB, and the build fails if one grows past its budget. Nothing runs in the background unless a feature needs it, and a feature you turn off registers nothing at all.`,
  },
  {
    title: "Built for busy servers",
    text: "What's checked often, such as bans, mutes, homes and balances, is answered from memory, and saves are written in the background.",
  },
  {
    title: "Change anything on reload",
    text: "Settings apply with /<plugin> reload; only a few storage settings ask for a restart. An update carries your config forward, and a bad value falls back to its default with a warning: a plugin never stops over its config.",
  },
  {
    title: "Paper and Folia",
    text: `${folia} of the ${count} run on Folia from the same jar. Every plugin is started on real servers in CI, on the oldest and newest Minecraft it supports.`,
  },
  {
    title: "Free and open source",
    text: "Every feature in every plugin, under GPL-3.0. No premium versions, no early-access builds, nothing behind a Patreon.",
  },
  {
    title: "Easy to switch to",
    text: "Where a plugin replaces a popular one, it speaks its commands and imports its data, so your staff and your history come with you.",
  },
];
---
<section class="reasons" aria-label="Why server owners pick them">
  {reasons.map((r) => (
    <div>
      <h2>{r.title}</h2>
      <p>{r.text}</p>
    </div>
  ))}
</section>

<section class="catalog" id="plugins" aria-label="The plugins">
  <div class="search">
    <label for="plugin-search">Find a plugin</label>
    <input id="plugin-search" type="search" placeholder="bans, economy, teleport…" autocomplete="off" />
  </div>
  {catalog.categories.map((category) => (
    <div class="category" data-category>
      <h2>{category}</h2>
      <ul>
        {plugins
          .filter((p) => p.category === category)
          .map((p) => (
            <li
              style={`--plugin-accent: ${p.accentText}`}
              data-search={`${p.name} ${p.category} ${p.tagline} ${p.blurb} ${p.summary}`.toLowerCase()}
            >
              <a href={p.docs}>
                <img src={icon(p.id)} alt="" width="56" height="56" />
                <span class="name">{p.name}</span>
                <span class="badges">
                  {!p.released && <span class="badge soon">Coming soon</span>}
                  {p.folia && <span class="badge">Folia</span>}
                  {p.api && <span class="badge">API</span>}
                </span>
                <span class="tagline">{p.tagline}</span>
                <span class="blurb" set:html={html(p.blurb)} />
              </a>
            </li>
          ))}
      </ul>
    </div>
  ))}
  <p class="none" hidden>No plugin matches that yet. <a href="https://github.com/xena-studios/plugins/issues/new/choose">Ask for one</a>.</p>
</section>

<script>
  // Filters the cards as you type; each category hides when none of its plugins match.
  const input = document.querySelector<HTMLInputElement>("#plugin-search");
  input?.addEventListener("input", () => {
    const words = input.value.toLowerCase().split(/\s+/).filter(Boolean);
    let shown = 0;
    for (const category of document.querySelectorAll<HTMLElement>("[data-category]")) {
      let inCategory = 0;
      for (const card of category.querySelectorAll<HTMLElement>("li[data-search]")) {
        const match = words.every((w) => card.dataset.search!.includes(w));
        card.hidden = !match;
        if (match) inCategory++;
      }
      category.hidden = inCategory === 0;
      shown += inCategory;
    }
    document.querySelector<HTMLElement>(".catalog .none")!.hidden = shown > 0;
  });
</script>

<style>
  .reasons {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1.25rem 2rem;
    margin-block: 2.5rem 3.5rem;
  }
  .reasons div {
    margin: 0;
  }
  .reasons h2 {
    margin: 0 0 0.35rem;
    font-size: 1.05rem;
    color: var(--sl-color-white);
  }
  .reasons p {
    margin: 0;
    color: var(--sl-color-gray-2);
    font-size: 0.95rem;
  }
  .catalog {
    margin-top: 0;
  }
  .search {
    display: grid;
    gap: 0.4rem;
    max-width: 28rem;
    margin-bottom: 2rem;
  }
  .search label {
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
  }
  .search input {
    padding: 0.7rem 1rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 999px;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
    font: inherit;
  }
  .search input:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }
  .category {
    margin-top: 2rem;
  }
  .category h2 {
    margin: 0 0 1rem;
    font-family: var(--mono);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
  }
  .category ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .category li {
    margin: 0;
  }
  .category a {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas: "icon name" "icon badges" "tagline tagline" "blurb blurb";
    gap: 0.2rem 1rem;
    height: 100%;
    padding: 1.25rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 14px;
    background: var(--sl-color-gray-6);
    text-decoration: none;
    transition: border-color 0.2s var(--ease), transform 0.2s var(--ease);
  }
  .category a:hover,
  .category a:focus-visible {
    border-color: var(--plugin-accent);
    transform: translateY(-2px);
  }
  .category img {
    grid-area: icon;
    border-radius: 12px;
  }
  .name {
    grid-area: name;
    align-self: end;
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--sl-color-white);
  }
  .category a:hover .name {
    color: var(--plugin-accent);
  }
  .badges {
    grid-area: badges;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    align-self: start;
  }
  .badge {
    padding: 0.05rem 0.5rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 999px;
    font-family: var(--mono);
    font-size: 0.68rem;
    color: var(--sl-color-gray-3);
  }
  .badge.soon {
    border-color: color-mix(in srgb, var(--plugin-accent) 55%, transparent);
    color: var(--plugin-accent);
  }
  .tagline {
    grid-area: tagline;
    margin-top: 0.85rem;
    font-weight: 600;
    color: var(--sl-color-gray-1);
  }
  .blurb {
    grid-area: blurb;
    font-size: 0.9rem;
    color: var(--sl-color-gray-3);
  }
  .none {
    color: var(--sl-color-gray-3);
  }
  @media (prefers-reduced-motion: reduce) {
    .category a {
      transition: none;
    }
    .category a:hover {
      transform: none;
    }
  }
</style>
