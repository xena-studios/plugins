---
// A plugin's download page: its latest version first, then every version before it, read
// when the site is built (a release redeploys the site, and it's rebuilt daily). For a plugin
// on Modrinth they come from Modrinth's API and downloads go through Modrinth's CDN, so they
// count on Modrinth; a version that's also a GitHub release links it as a mirror. A plugin Modrinth is
// still reviewing (src/data/modrinth.json) has no public Modrinth page yet, so its versions
// and jars come from its GitHub releases, as they do when Modrinth can't be reached. Before a
// plugin's first release, or if neither can be reached, the page says so and links what there
// is instead.
import catalog from "../data/plugins.json" with { type: "json" };
import { releases } from "../releases.ts";
import External from "./External.astro";

interface Props {
  plugin: string;
}
interface ModrinthFile {
  url: string;
  filename: string;
  primary: boolean;
  size: number;
}
interface ModrinthVersion {
  version_number: string;
  version_type: "release" | "beta" | "alpha";
  date_published: string;
  game_versions: string[];
  loaders: string[];
  files: ModrinthFile[];
}
/** A version, from Modrinth or from GitHub. */
interface Version {
  number: string;
  /** "release", or Modrinth's "beta" or "alpha", or GitHub's "pre-release". */
  type: string;
  date: string;
  /** From Modrinth only: GitHub doesn't say. */
  minecraft?: string;
  loaders?: string;
  file: { url: string; name: string; size: number };
  github: string;
}

const { plugin: id } = Astro.props;
const p = catalog.plugins.find((x) => x.id === id);
if (!p) throw new Error(`Downloads: ${id} isn't in the catalog`);
const repo = "https://github.com/xena-studios/plugins";
const everyRelease = `${repo}/releases?q=${id}-v`;

// "1.21.11 to 26.3", from Modrinth's list (oldest first).
const minecraft = (v: ModrinthVersion) =>
  v.game_versions.length > 1 ? `${v.game_versions[0]} to ${v.game_versions.at(-1)}` : (v.game_versions[0] ?? "");
const loaders = (v: ModrinthVersion) =>
  v.loaders.map((l) => ({ paper: "Paper", folia: "Folia", purpur: "Purpur", spigot: "Spigot", bukkit: "Bukkit" })[l] ?? l).join(", ");

let versions: Version[] = [];
let from: "modrinth" | "github" | null = null;
let unreachable = false;
if (p.modrinth) {
  try {
    const answer = await fetch(`https://api.modrinth.com/v2/project/${id}/version`, {
      headers: { "User-Agent": "xena-studios/plugins docs build (contact@xenastudios.co)" },
      signal: AbortSignal.timeout(15_000),
    });
    if (answer.ok) {
      versions = ((await answer.json()) as ModrinthVersion[]).flatMap((v) => {
        const file = v.files.find((f) => f.primary) ?? v.files[0];
        if (!file) return [];
        return [{
          number: v.version_number,
          type: v.version_type,
          date: v.date_published,
          minecraft: minecraft(v),
          loaders: loaders(v),
          file: { url: file.url, name: file.filename, size: file.size },
          github: `${repo}/releases/tag/${id}-v${v.version_number}`,
        }];
      });
      if (versions.length) from = "modrinth";
    } else if (answer.status !== 404) unreachable = true;
  } catch {
    unreachable = true;
  }
}
// Not on Modrinth yet, or Modrinth couldn't say: its GitHub releases.
if (!versions.length && p.released) {
  const found = await releases(id);
  if (found) {
    unreachable = false;
    versions = found.map((r) => ({
      number: r.version,
      type: r.prerelease ? "pre-release" : "release",
      date: r.date,
      file: r.jar,
      github: r.page,
    }));
    if (versions.length) from = "github";
  } else unreachable = true;
}
// Newest first, as both send them; the latest is the newest full release.
const latest = versions.find((v) => v.type === "release") ?? versions[0];
// Modrinth also has versions from before this repository (xUtilities 1.x, for one), which
// were never GitHub releases: only the ones that are link their mirror. If GitHub can't say,
// every version links it, as most are.
const mirrored = from === "modrinth" ? await releases(id) : null;
const hasMirror = (v: Version) => !mirrored || mirrored.some((r) => r.version === v.number);

const date = (iso: string) =>
  new Date(iso).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
const size = (bytes: number) => `${Math.round(bytes / 1024)} KiB`;
// The changelog page's heading for a version ("## 2.1.0" becomes #210).
const changes = (v: Version) => `/${id}/changelog/#${v.number.toLowerCase().replace(/[^a-z0-9-]/g, "")}`;
const runsOn = p.folia ? "Paper, Purpur and Folia" : "Paper and Purpur";
// The oldest Minecraft every plugin supports (gradle/libs.versions.toml), as on each overview.
const facts = (v: Version) =>
  from === "modrinth"
    ? `Minecraft ${v.minecraft} · ${v.loaders} · ${date(v.date)}`
    : `${runsOn} 1.21.11+ · ${date(v.date)}`;
---
{
  latest ? (
    <div class="latest gui-tooltip not-content" style={`--item: ${p.accentText}`}>
      <p class="version">
        {p.name} {latest.number}
      </p>
      <p class="facts gui-stat">{facts(latest)}</p>
      <p class="actions">
        <a class="gui-button primary" href={latest.file.url} download>
          Download {latest.file.name} <span class="size">({size(latest.file.size)})</span>
        </a>
        <a class="gui-button" href={changes(latest)}>What's new</a>
        {from === "modrinth" ? (
          <a class="gui-button" href={p.modrinth!}>
            Modrinth
            <External />
          </a>
        ) : (
          <a class="gui-button" href={latest.github}>
            GitHub
            <External />
          </a>
        )}
      </p>
      <p class="needs">Needs Java 21 or newer. {p.folia ? "One jar runs on Paper, Purpur and Folia." : "Runs on Paper and Purpur."}</p>
    </div>
  ) : (
    <div class="latest gui-tooltip not-content" style={`--item: ${p.accentText}`}>
      <p class="facts">
        {!p.released
          ? `${p.name} isn't released yet. Its first version will be here.`
          : unreachable
            ? `${p.name}'s versions couldn't be read when this page was built.`
            : `${p.name}'s versions are on GitHub.`}
      </p>
      {p.released && (
        <p class="actions">
          <a class="gui-button primary" href={everyRelease}>
            Every version on GitHub
            <External />
          </a>
          {p.modrinth && (
            <a class="gui-button" href={`${p.modrinth}/versions`}>
              Modrinth
              <External />
            </a>
          )}
        </p>
      )}
    </div>
  )
}

{
  versions.length > 0 && (
    <>
      <h2 id="every-version">Every version</h2>
      <table class="versions">
        <thead>
          <tr>
            <th>Version</th>
            <th>Released</th>
            {from === "modrinth" && <th>Minecraft</th>}
            {from === "modrinth" && <th>Runs on</th>}
            <th>Download</th>
          </tr>
        </thead>
        <tbody>
          {versions.map((v) => (
            <tr>
              <td>
                <a href={changes(v)}>{v.number}</a>
                {v.type !== "release" && <span class="type">{v.type}</span>}
              </td>
              <td>{date(v.date)}</td>
              {from === "modrinth" && <td>{v.minecraft}</td>}
              {from === "modrinth" && <td>{v.loaders}</td>}
              <td>
                <a href={v.file.url} download>
                  .jar
                </a>
                {from === "modrinth" && hasMirror(v) && (
                  <>
                    {" "}
                    · <a href={v.github}>GitHub</a>
                  </>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      <p>
        {from === "modrinth" ? (
          <>
            {versions.every(hasMirror) ? "Every version" : "Each version marked GitHub"} is also a <a href={everyRelease}>GitHub release</a>, with the same jar.
          </>
        ) : (
          <>
            Every version is a <a href={everyRelease}>GitHub release</a>.
          </>
        )}{" "}
        The <a href={`/${id}/changelog/`}>changelog</a> says what changed in each.
      </p>
    </>
  )
}

<style>
  .latest {
    display: grid;
    gap: 0.55rem;
    margin-block: 1.5rem 2.5rem;
    padding: clamp(1.25rem, 3vw, 2rem);
  }
  .latest p {
    margin: 0;
  }
  .version {
    font-size: clamp(1.75rem, 1.4rem + 1.4vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.05;
    color: var(--item);
  }
  .facts {
    color: var(--gui-attribute);
  }
  .needs {
    font-size: 0.875rem;
    color: var(--gui-lore);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-block: 0.6rem 0.2rem !important;
  }
  .size {
    font-weight: 500;
    opacity: 0.7;
    font-variant-numeric: tabular-nums;
  }
  .versions :global(td:nth-child(2)),
  .versions :global(td:nth-child(3)) {
    font-variant-numeric: tabular-nums;
  }
  .versions :global(td) {
    white-space: nowrap;
  }
  .versions :global(a) {
    color: var(--text);
  }
  .versions :global(a:hover) {
    color: var(--sl-color-accent);
  }
  .type {
    margin-inline-start: 0.5rem;
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--gui-lore);
  }
</style>
