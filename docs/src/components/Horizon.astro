---
// The plugin family's stepped horizon (xena-studios/brand plugins/horizon.svg),
// its rim in all three accents: scaled from the bottom edge, fading into the page.
import raw from "../assets/horizon.svg?raw";
const svg = raw.replace(/ width="[^"]*" height="[^"]*"/, ` preserveAspectRatio="xMidYMax slice" class="horizon" aria-hidden="true" focusable="false"`);
---
<div class="horizon-wrap"><Fragment set:html={svg} /></div>

<style>
  .horizon-wrap {
    width: 100vw;
    margin-inline: calc(50% - 50vw);
    height: clamp(6rem, 15vw, 10.5rem);
    margin-top: clamp(1rem, 3vw, 2.5rem);
    pointer-events: none;
  }
  .horizon-wrap :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
    -webkit-mask-image: linear-gradient(to bottom, #000 55%, transparent);
    mask-image: linear-gradient(to bottom, #000 55%, transparent);
  }
</style>
