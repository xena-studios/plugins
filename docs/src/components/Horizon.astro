---
// The family's planet horizon, drawn from the brand catalog so its rim carries every plugin:
// the arc is stepped in pixel blocks, as the brand draws it, and each plugin owns one stretch
// of the rim in its own accent, in catalog order. A new plugin joins the rim on its own.
// It sits under the inventory as the floor the chest rests on.
import catalog from "../data/plugins.json" with { type: "json" };

const W = 2400;
const H = 520;
const R = 3200; // the planet's radius: a gentle arc
const top = 70; // the arc's highest point
const step = 24; // one pixel block, as on the brand's horizon
const cy = top + R;
const plugins = catalog.plugins;
const yAt = (x: number) => cy - Math.sqrt(Math.max(0, R * R - (x - W / 2) ** 2));

const blocks: { x: number; y: number; color: string }[] = [];
for (let x = 0; x < W; x += step) {
  const y = Math.round(yAt(x + step / 2) / 4) * 4;
  const owner = plugins[Math.min(plugins.length - 1, Math.floor((x / W) * plugins.length))];
  blocks.push({ x, y, color: owner.accent });
}
// The planet's body under the rim, following the same steps.
const body = `M0 ${H} ` + blocks.map((b) => `L${b.x} ${b.y + 4} L${b.x + step} ${b.y + 4}`).join(" ") + ` L${W} ${H} Z`;
const stops = plugins.map((p, i) => ({ offset: (i + 0.5) / plugins.length, color: p.accent }));
---
<div class="horizon-wrap" aria-hidden="true">
  <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMin slice" focusable="false">
    <defs>
      <linearGradient id="horizon-body" x1="0" y1={top} x2="0" y2={H} gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="#1B1A21" />
        <stop offset="1" stop-color="#121116" />
      </linearGradient>
      <linearGradient id="horizon-glow" x1="0" y1="0" x2={W} y2="0" gradientUnits="userSpaceOnUse">
        {stops.map((s) => <stop offset={s.offset} stop-color={s.color} />)}
      </linearGradient>
      <filter id="horizon-blur" x="-10%" y="-200%" width="120%" height="500%">
        <feGaussianBlur stdDeviation="22" />
      </filter>
    </defs>
    <path d={body} fill="url(#horizon-body)" />
    <path d={blocks.map((b) => `M${b.x} ${b.y} h${step}`).join(" ")} stroke="url(#horizon-glow)" stroke-width="18" opacity="0.32" filter="url(#horizon-blur)" />
    {blocks.map((b) => <rect x={b.x} y={b.y} width={step} height="4" fill={b.color} />)}
  </svg>
</div>

<style>
  .horizon-wrap {
    width: 100vw;
    margin-inline: calc(50% - 50vw);
    height: clamp(5rem, 11vw, 8.5rem);
    margin-top: calc(clamp(1.5rem, 4vw, 3rem) * -1);
    pointer-events: none;
  }
  svg {
    display: block;
    width: 100%;
    height: 100%;
    -webkit-mask-image: linear-gradient(to bottom, #000 45%, transparent);
    mask-image: linear-gradient(to bottom, #000 45%, transparent);
  }
</style>
