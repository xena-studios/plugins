---
// A plugin's pages carry its icon beside the title, alongside its accent
// (src/routeData.ts).
import Default from "@astrojs/starlight/components/PageTitle.astro";
import catalog from "../data/plugins.json" with { type: "json" };

// Every plugin's icon, synced from the brand repo (scripts/sync-brand.ts).
const files = import.meta.glob<{ default: ImageMetadata }>("../assets/plugins/*.svg", { eager: true });
const icons = Object.fromEntries(catalog.plugins.map((p) => [p.id, files[`../assets/plugins/${p.id}.svg`]?.default]));
const id = Astro.locals.starlightRoute.id;
const plugin = catalog.plugins.map((p) => p.id).find((p) => id === p || id.startsWith(`${p}/`));
---
{
  plugin && icons[plugin] ? (
    <div class="plugin-title">
      <img src={icons[plugin]!.src} alt="" width="44" height="44" />
      <Default />
    </div>
  ) : (
    <Default />
  )
}

<style>
  .plugin-title {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 1rem;
  }
  .plugin-title img {
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 10px;
  }
  .plugin-title :global(h1) {
    margin-top: 0;
  }
</style>
