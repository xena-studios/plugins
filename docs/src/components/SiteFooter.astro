---
// The site footer, laid out as on Xena's other sites (xenastudios.co,
// raptorpanel.net, NeoSkript's site): the XENA mark and the copyright, a line on
// the licence, then the site's links. Starlight's own footer (edit link,
// previous and next) comes first; see Footer.astro. Colours are Starlight's
// theme colours, so it follows the light theme too.
import xena from "../assets/xena.svg?raw";
import External from "./External.astro";

const year = new Date().getFullYear();
const repo = "https://github.com/xena-studios/plugins";

// The logo exports carry 50 units of clear space on every side (scripts/build.mjs
// in the brand repo); the footer spaces the mark itself, so the viewBox drops it.
// The mark takes the text colour.
const [, w, h] = xena.match(/viewBox="0 0 ([\d.]+) ([\d.]+)"/) ?? [];
const viewBox = `50 50 ${Number(w) - 100} ${Number(h) - 100}`;
const mark = xena
  .replace(/^<svg[^>]*>/, "")
  .replace(/<\/svg>\s*$/, "")
  .replace(/fill="#[0-9A-Fa-f]{6}"/g, 'fill="currentColor"');

const links = [
  { label: "xUtilities", href: "/xutilities/" },
  { label: "zChat", href: "/zchat/" },
  { label: "xLimbo", href: "/xlimbo/" },
  { label: "xRewind", href: "/xrewind/" },
  { label: "Modrinth", href: "https://modrinth.com/organization/xena-studios", external: true },
  { label: "Source", href: repo, external: true },
  { label: "Report a bug", href: `${repo}/issues/new/choose`, external: true },
];
---
<footer class="site-footer">
  <p class="studio">
    <a class="xena" href="https://xenastudios.co" aria-label="Xena Studios">
      <svg class="logo" viewBox={viewBox} role="img" aria-hidden="true" set:html={mark} />
    </a>
    <span class="label">© {year} Xena Studios</span>
  </p>
  <p class="note">
    xUtilities, zChat, xLimbo and xRewind are open source under GPL-3.0-only. Not an official Minecraft product; not
    approved by or associated with Mojang or Microsoft.
  </p>
  <nav aria-label="Footer">
    <ul>
      {links.map((link) => (
        <li><a href={link.href}>{link.label}{link.external && <External />}</a></li>
      ))}
    </ul>
  </nav>
</footer>

<style>
  .site-footer {
    display: grid;
    gap: 1rem;
    margin-top: 3rem;
    padding-block: 2.5rem 1rem;
    border-top: 1px solid var(--sl-color-hairline);
    color: var(--sl-color-gray-3);
    font-size: 0.9375rem;
  }
  .studio {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.25rem;
    margin: 0;
  }
  .label {
    font-family: var(--mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .note {
    margin: 0;
    max-width: 72ch;
    font-size: 0.875rem;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.75rem;
    margin: 0.25rem 0 0;
    padding: 0;
    list-style: none;
  }
  li {
    margin: 0;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  a:hover,
  a:focus-visible {
    color: var(--sl-color-white);
  }
  .xena {
    display: inline-flex;
    color: var(--sl-color-white);
  }
  .logo {
    height: 0.9rem;
    width: auto;
  }
</style>
