---
// How to install a rewritten plugin, one tab per platform it's released on (from its manifest),
// so an owner reads only their server's steps. The tabs share a sync key, so the platform you
// pick is the one every other page's tabs open on. A page can add its own steps below.
import { TabItem, Tabs } from "@astrojs/starlight/components";
import { getEntry } from "astro:content";
import type { Manifest, Platform } from "../reference/manifest";

interface Props {
  plugin: string;
}
const { plugin } = Astro.props;
const entry = await getEntry("references", plugin);
if (!entry) throw new Error(`InstallTabs: ${plugin} has no manifest (src/generated/${plugin}/manifest.json)`);
const m = entry.data as unknown as Manifest;
const name = m.plugin.name;
const platforms = m.platforms.filter((p) => p.status === "release");
const download = `/${plugin}/download/`;

const versions = (p: Platform) =>
  p.minVersion === p.maxVersion ? p.minVersion : p.maxVersion === "latest" ? `${p.minVersion} or newer` : `${p.minVersion} to ${p.maxVersion}`;

/** Where the jar goes, and what else the platform needs, by platform id. */
const steps = (p: Platform): { folder: string; needs?: string; restart: string } => {
  switch (p.id) {
    case "fabric":
      return {
        folder: "mods/",
        needs: "Fabric Loader and Fabric Language Kotlin, which gives the mod Kotlin. Fabric jars are one per Minecraft line, so pick the one for your version.",
        restart: "Start the server.",
      };
    case "velocity":
    case "bungeecord":
      return { folder: "plugins/ on the proxy", restart: "Restart the proxy." };
    default:
      return { folder: "plugins/", restart: "Restart the server (not /reload, which no plugin supports well)." };
  }
};
---
{
  platforms.length ? (
    <Tabs syncKey="platform">
      {platforms.map((p) => {
        const s = steps(p);
        return (
          <TabItem label={p.name}>
            <ol>
              <li>
                Check your server: {p.name} {versions(p)}
                {p.java && <>, on Java {p.java} or newer</>}.
              </li>
              {s.needs && <li>Install {s.needs}</li>}
              <li>
                <a href={download}>Download {name}</a> for {p.name} and your Minecraft version, and put the jar in <code>{s.folder}</code>.
              </li>
              <li>{s.restart} {name} writes its config on the first start.</li>
            </ol>
          </TabItem>
        );
      })}
    </Tabs>
  ) : (
    <p>{name} isn't released on any platform yet.</p>
  )
}
