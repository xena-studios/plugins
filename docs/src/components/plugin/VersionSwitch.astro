---
// Under the title of a plugin whose docs cover more than one major (src/data/versions.json):
// which major you're reading, and a menu to the same page in each other one (or its overview,
// where that major has no such page). A <details>, so it works without JavaScript. On an old
// major's pages, a note says so and links the newest.
import { Aside } from "@astrojs/starlight/components";
import { getCollection } from "astro:content";
import { majorOf, pageUrl, pluginOf } from "../../plugins";

const route = Astro.locals.starlightRoute;
const plugin = pluginOf(route.id);
const page = plugin && majorOf(plugin, route.id);
const ids = new Set((await getCollection("docs")).map((e) => e.id));

const majors = plugin?.newest !== undefined && plugin.older.length ? [plugin.newest, ...plugin.older] : [];
/** The same page in [major], or that major's overview. */
const target = (major: number) => {
  if (!plugin || !page) return "/";
  const base = major === plugin.newest ? plugin.id : `${plugin.id}/v${major}`;
  return ids.has(page.rest ? `${base}/${page.rest}` : base) ? pageUrl(plugin, major, page.rest) : pageUrl(plugin, major, "");
};
---
{
  plugin && page && majors.length > 0 && (
    <>
      <nav class="version-switch" aria-label={`${plugin.name} versions`}>
        <details>
          <summary>
            <span class="label">Version</span> {page.major}.x
          </summary>
          <ul>
            {majors.map((major) => (
              <li>
                <a href={target(major)} aria-current={major === page.major ? "page" : undefined}>
                  {`${plugin.name} ${major}.x`}{major === plugin.newest && <span class="hint"> newest</span>}
                </a>
              </li>
            ))}
          </ul>
        </details>
      </nav>
      {!page.newest && (
        <Aside type="caution" title={`${plugin.name} ${page.major}.x`}>
          {`These pages are for ${plugin.name} ${page.major}.x, which gets only fixes now. The newest is `}
          <a href={target(plugin.newest!)}>{`${plugin.name} ${plugin.newest}.x`}</a>.
        </Aside>
      )}
    </>
  )
}

<style>
  .version-switch {
    position: relative;
    margin-top: 0.75rem;
  }
  summary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.65rem;
    cursor: pointer;
    list-style: none;
    font-weight: 600;
    color: var(--text);
    background: var(--gui-slot);
    border: var(--gui-px) solid var(--gui-edge);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: "▾";
    color: var(--muted);
  }
  .label {
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  ul {
    display: grid;
    gap: 0.1rem;
    margin: 0.4rem 0 0;
    padding: 0.3rem;
    list-style: none;
    width: max-content;
    background: var(--gui-panel);
    border: var(--gui-px) solid var(--gui-edge);
  }
  li {
    margin: 0;
  }
  li a {
    display: block;
    padding: 0.3rem 0.6rem;
    color: var(--sl-color-gray-2);
    text-decoration: none;
  }
  li a:hover {
    color: var(--text);
    background: var(--gui-slot);
  }
  li a[aria-current="page"] {
    color: var(--sl-color-accent);
  }
  .hint {
    font-size: 0.8rem;
    color: var(--muted);
  }
</style>
