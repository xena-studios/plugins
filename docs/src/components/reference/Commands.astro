---
// Every command and subcommand that does something, with its arguments, aliases, permission,
// cooldown and confirmation, from the plugin's command tree: the one the server runs. The
// permission sits under the usage, so the table fits the reading column.
import { Badge } from "@astrojs/starlight/components";
import { type Command, flatten, range } from "./manifest";
import "./reference.css";

interface Props {
  commands: Command[];
}
const rows = flatten(Astro.props.commands).filter((c) => c.executable);
---
<table class="ref-commands">
  <thead>
    <tr><th>Command</th><th>What it does</th></tr>
  </thead>
  <tbody>
    {rows.map((c) => (
      <tr>
        <td>
          <code>{c.usage}</code>
          {c.aliases.length > 0 && <div class="ref-hint">also {c.aliases.map((a, i) => <>{i > 0 && ", "}<code>{a}</code></>)}</div>}
          <div class="ref-hint">{c.permission ? <code>{c.permission}</code> : "no permission of its own"}</div>
        </td>
        <td>
          {c.description}
          {c.playerOnly && <> <Badge text="Players only" variant="default" /></>}
          {c.confirm && <> <Badge text="Asks to confirm" variant="caution" /></>}
          {c.builtIn && <> <Badge text="Every plugin" variant="note" /></>}
          {c.cooldown && (
            <div class="ref-hint">
              Once every <code>{c.cooldown}</code>{c.cooldownBypass && <>, except with <code>{c.cooldownBypass}</code></>}
            </div>
          )}
          {c.arguments.length > 0 && (
            <dl class="ref-args">
              {c.arguments.map((a) => (
                <>
                  <dt><code>{a.required ? `<${a.name}>` : `[${a.name}]`}</code></dt>
                  <dd>
                    {a.description}{" "}
                    <span class="ref-hint">
                      {[a.type, range(a.min, a.max), a.choices.join(" | "), a.greedy ? "the rest of the line" : "", a.required ? "" : "optional"]
                        .filter(Boolean)
                        .join(", ")}
                    </span>
                  </dd>
                </>
              ))}
            </dl>
          )}
        </td>
      </tr>
    ))}
  </tbody>
</table>

<style>
  .ref-args {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.25rem 0.75rem;
    margin-top: 0.5rem;
    font-size: var(--sl-text-sm);
  }
  .ref-args dt,
  .ref-args dd {
    margin: 0;
  }
</style>
