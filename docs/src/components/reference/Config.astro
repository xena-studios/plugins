---
// config.yml key by key, from the plugin's config schema: type, default and range. Pass the
// default file as `yaml` to show it below the table.
import { Code } from "@astrojs/starlight/components";
import { type Config, type ConfigEntry, range } from "./manifest";
import "./reference.css";

interface Props {
  config: Config;
  /** The default config.yml (src/generated/<plugin>/config.yml), shown under the table. */
  yaml?: string;
  /** The file's title, such as plugins/xHomes/config.yml. */
  title?: string;
}
const { config, yaml, title } = Astro.props;
const flat = (entries: ConfigEntry[]): ConfigEntry[] => entries.flatMap((e) => [e, ...flat(e.entries)]);
---
<table class="ref-config">
  <thead>
    <tr><th>Key</th><th>Default</th><th>What it does</th></tr>
  </thead>
  <tbody>
    {flat(config.entries).map((e) =>
      e.type === "section" ? (
        <tr class="ref-section">
          <td colspan="3"><code>{e.path}</code> <span class="ref-hint">{e.comment.join(" ")}</span></td>
        </tr>
      ) : (
        <tr>
          <td><code>{e.path}</code></td>
          <td><code>{e.defaultText}</code></td>
          <td>
            {e.comment.join(" ")}
            <div class="ref-hint">{[e.type, range(e.min, e.max), e.choices.join(" | ")].filter(Boolean).join(", ")}</div>
          </td>
        </tr>
      ),
    )}
  </tbody>
</table>
{yaml && <Code code={yaml} lang="yaml" title={title} />}

<style>
  .ref-section td {
    background: var(--gui-slot);
  }
</style>
