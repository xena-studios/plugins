---
// The API's events, for developers: what fires, and whether it can be cancelled.
import type { ApiEvent } from "./manifest";
import "./reference.css";

interface Props {
  events: ApiEvent[];
}
const short = (c: string) => c.slice(c.lastIndexOf(".") + 1);
---
<table class="ref-events">
  <thead>
    <tr><th>Event</th><th>When</th></tr>
  </thead>
  <tbody>
    {Astro.props.events.map((e) => (
      <tr>
        <td>
          <code title={e.className}>{short(e.className)}</code>
          <div class="ref-hint">{[e.cancellable ? "cancellable" : "", e.since ? `since ${e.since}` : ""].filter(Boolean).join(", ")}</div>
        </td>
        <td>
          {e.description}
          <div class="ref-hint"><code>{e.key}</code></div>
        </td>
      </tr>
    ))}
  </tbody>
</table>
