---
// Every message with its English text and the tags it fills in. How complete each language
// is joins this once the translations' coverage is in the manifest.
import type { Message } from "./manifest";
import "./reference.css";

interface Props {
  messages: Message[];
}
---
<table class="ref-messages">
  <thead>
    <tr><th>Key</th><th>English</th><th>Fills in</th></tr>
  </thead>
  <tbody>
    {Astro.props.messages.map((m) => (
      <tr>
        <td><code>{m.key}</code><div class="ref-hint">{m.comment.join(" ")}</div></td>
        <td><code>{m.english}</code></td>
        <td>{m.placeholders.map((p, i) => <>{i > 0 && " "}<code>{`<${p}>`}</code></>)}</td>
      </tr>
    ))}
  </tbody>
</table>
