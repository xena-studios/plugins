---
// Every permission node: who has it by default, what it grants, and the commands that need it.
import { Badge } from "@astrojs/starlight/components";
import type { Permission, PermissionDefault } from "./manifest";
import "./reference.css";

interface Props {
  permissions: Permission[];
}
const defaults: Record<PermissionDefault, string> = { op: "Operators", everyone: "Everyone", nobody: "Nobody", "not-op": "Non-operators" };
---
<table class="ref-permissions">
  <thead>
    <tr><th>Permission</th><th>Gives</th><th>Default</th></tr>
  </thead>
  <tbody>
    {Astro.props.permissions.map((p) => (
      <tr>
        <td><code>{p.node}</code></td>
        <td>
          {p.description}
          {p.builtIn && <> <Badge text="Every plugin" variant="note" /></>}
          {Object.keys(p.children).length > 0 && (
            <div class="ref-hint">
              {Object.entries(p.children).map(([node, on], i) => <>{i > 0 && ", "}{on ? "grants" : "takes away"} <code>{node}</code></>)}
            </div>
          )}
          {p.commands.length > 0 && <div class="ref-hint">for {p.commands.map((c, i) => <>{i > 0 && ", "}<code>/{c}</code></>)}</div>}
        </td>
        <td>{defaults[p.default]}</td>
      </tr>
    ))}
  </tbody>
</table>
