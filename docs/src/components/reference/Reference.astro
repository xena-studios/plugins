---
// One section of a plugin's reference, from its manifest (src/generated/<plugin>/manifest.json,
// validated against the schema in content.config.ts), so a page needs one line:
//
//   <Reference plugin="xsample" show="commands" />
//
// A plugin with nothing in a section gets a line saying so rather than an empty table, so a
// section the core hasn't filled yet (messages and events, as they land) still reads.
// A plugin without a manifest fails the build.
import { getEntry } from "astro:content";
import Commands from "./Commands.astro";
import Config from "./Config.astro";
import Events from "./Events.astro";
import Messages from "./Messages.astro";
import Permissions from "./Permissions.astro";
import Placeholders from "./Placeholders.astro";
import Platforms from "./Platforms.astro";
import type { Manifest } from "./manifest";

interface Props {
  plugin: string;
  show: "platforms" | "commands" | "permissions" | "config" | "messages" | "placeholders" | "events";
}
const { plugin, show } = Astro.props;
const entry = await getEntry("references", plugin);
if (!entry) throw new Error(`Reference: ${plugin} has no manifest (src/generated/${plugin}/manifest.json). Run ./gradlew updateXenaManifest.`);
const m = entry.data as unknown as Manifest;
const name = m.plugin.name;

// The default config.yml the same build writes beside the manifest.
const files = import.meta.glob<string>("../../generated/*/config.yml", { query: "?raw", import: "default", eager: true });
const yaml = files[`../../generated/${plugin}/config.yml`];

const commands = m.commands ?? [];
const permissions = m.permissions ?? [];
const placeholders = m.placeholders ?? [];
const messages = m.messages ?? [];
const events = m.events ?? [];
const platforms = m.platforms ?? [];
---
{show === "platforms" && (platforms.length ? <Platforms platforms={platforms} /> : <p>{name}'s platforms aren't set yet.</p>)}
{show === "commands" && (commands.length ? <Commands commands={commands} /> : <p>{name} has no commands.</p>)}
{show === "permissions" && (permissions.length ? <Permissions permissions={permissions} /> : <p>{name} has no permissions.</p>)}
{show === "config" &&
  (m.config?.entries.length ? (
    <Config config={m.config} yaml={yaml} title={`plugins/${name}/config.yml`} />
  ) : (
    <p>{name} has no config.yml.</p>
  ))}
{show === "messages" && (messages.length ? <Messages messages={messages} /> : <p>{name}'s messages aren't listed here yet.</p>)}
{show === "placeholders" && (placeholders.length ? <Placeholders placeholders={placeholders} /> : <p>{name} has no placeholders.</p>)}
{show === "events" && (events.length ? <Events events={events} /> : <p>{name}'s API has no events yet.</p>)}
