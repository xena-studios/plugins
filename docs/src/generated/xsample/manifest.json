{
  "$schema": "../manifest.schema.json",
  "formatVersion": 1,
  "plugin": {
    "id": "xsample",
    "name": "xSample",
    "version": "1.0.0",
    "description": "The core's sample plugin, never released."
  },
  "platforms": [
    {
      "id": "paper",
      "name": "Paper",
      "kind": "server",
      "minVersion": "1.8.8",
      "maxVersion": "latest",
      "java": 8,
      "status": "release",
      "since": "1.0.0"
    },
    {
      "id": "folia",
      "name": "Folia",
      "kind": "server",
      "minVersion": "1.20.6",
      "maxVersion": "latest",
      "java": 21,
      "status": "release",
      "since": "1.0.0"
    },
    {
      "id": "fabric",
      "name": "Fabric",
      "kind": "server",
      "minVersion": "1.20.1",
      "maxVersion": "latest",
      "java": 17,
      "status": "release",
      "since": "1.0.0"
    },
    {
      "id": "velocity",
      "name": "Velocity",
      "kind": "proxy",
      "minVersion": "3.3",
      "maxVersion": "latest",
      "java": 21,
      "status": "planned"
    },
    {
      "id": "pumpkin",
      "name": "Pumpkin",
      "kind": "server",
      "minVersion": "latest",
      "maxVersion": "latest",
      "status": "planned"
    }
  ],
  "commands": [
    {
      "path": "xsample",
      "usage": "/xsample [give|reload|debug|forget]",
      "aliases": [
        "coins"
      ],
      "description": "Shows your coins.",
      "playerOnly": true,
      "arguments": [],
      "executable": true,
      "confirm": false,
      "builtIn": false,
      "subcommands": [
        {
          "path": "xsample give",
          "usage": "/xsample give <player> <amount>",
          "aliases": [],
          "description": "Gives a player coins.",
          "permission": "xsample.give",
          "playerOnly": false,
          "arguments": [
            {
              "name": "player",
              "type": "player",
              "required": true,
              "greedy": false,
              "description": "Who gets them.",
              "choices": []
            },
            {
              "name": "amount",
              "type": "integer",
              "required": true,
              "greedy": false,
              "description": "How many coins.",
              "choices": [],
              "min": 1,
              "max": 1000000
            }
          ],
          "executable": true,
          "confirm": false,
          "builtIn": false,
          "subcommands": []
        },
        {
          "path": "xsample reload",
          "usage": "/xsample reload",
          "aliases": [],
          "description": "Reloads config.yml and the language files, and applies them.",
          "permission": "xsample.admin.reload",
          "playerOnly": false,
          "arguments": [],
          "executable": true,
          "confirm": false,
          "builtIn": true,
          "subcommands": []
        },
        {
          "path": "xsample debug",
          "usage": "/xsample debug",
          "aliases": [],
          "description": "Checks the database, dependencies and platform, then prints a paste link for support.",
          "permission": "xsample.admin.debug",
          "playerOnly": false,
          "arguments": [],
          "executable": true,
          "confirm": false,
          "builtIn": true,
          "subcommands": []
        },
        {
          "path": "xsample forget",
          "usage": "/xsample forget <player>",
          "aliases": [],
          "description": "Deletes everything kept about one player.",
          "permission": "xsample.admin.forget",
          "playerOnly": false,
          "arguments": [
            {
              "name": "player",
              "type": "player name or UUID",
              "required": true,
              "greedy": false,
              "description": "The player whose data is deleted, online or not.",
              "choices": []
            }
          ],
          "executable": true,
          "confirm": true,
          "builtIn": true,
          "subcommands": []
        }
      ]
    },
    {
      "path": "pay",
      "usage": "/pay <player> <amount>",
      "aliases": [],
      "description": "Pays another player.",
      "permission": "xsample.pay",
      "playerOnly": true,
      "arguments": [
        {
          "name": "player",
          "type": "player",
          "required": true,
          "greedy": false,
          "description": "Who to pay.",
          "choices": []
        },
        {
          "name": "amount",
          "type": "integer",
          "required": true,
          "greedy": false,
          "description": "How many coins.",
          "choices": [],
          "min": 1
        }
      ],
      "executable": true,
      "cooldown": "10s",
      "cooldownBypass": "xsample.pay.no-cooldown",
      "confirm": false,
      "builtIn": false,
      "subcommands": []
    }
  ],
  "permissions": [
    {
      "node": "xsample.pay",
      "description": "Pay other players.",
      "default": "everyone",
      "children": {},
      "commands": [
        "pay"
      ],
      "builtIn": false
    },
    {
      "node": "xsample.give",
      "description": "Give coins out of nowhere.",
      "default": "op",
      "children": {},
      "commands": [
        "xsample give"
      ],
      "builtIn": false
    },
    {
      "node": "xsample.pay.no-cooldown",
      "description": "Pay without waiting between payments.",
      "default": "op",
      "children": {},
      "commands": [],
      "builtIn": false
    },
    {
      "node": "xsample.*",
      "description": "Everything in xSample but the admin subcommands.",
      "default": "op",
      "children": {
        "xsample.pay": true,
        "xsample.give": true,
        "xsample.pay.no-cooldown": true
      },
      "commands": [],
      "builtIn": false
    },
    {
      "node": "xsample.admin",
      "description": "Every admin subcommand of xSample.",
      "default": "op",
      "children": {
        "xsample.admin.reload": true,
        "xsample.admin.debug": true,
        "xsample.admin.forget": true
      },
      "commands": [],
      "builtIn": true
    },
    {
      "node": "xsample.admin.reload",
      "description": "Use /xsample reload.",
      "default": "op",
      "children": {},
      "commands": [
        "xsample reload"
      ],
      "builtIn": true
    },
    {
      "node": "xsample.admin.debug",
      "description": "Use /xsample debug.",
      "default": "op",
      "children": {},
      "commands": [
        "xsample debug"
      ],
      "builtIn": true
    },
    {
      "node": "xsample.admin.forget",
      "description": "Use /xsample forget.",
      "default": "op",
      "children": {},
      "commands": [
        "xsample forget"
      ],
      "builtIn": true
    }
  ],
  "config": {
    "version": 1,
    "header": [
      "xSample: the core's sample plugin. Never released."
    ],
    "entries": [
      {
        "path": "messages",
        "type": "section",
        "comment": [
          "How this plugin's messages look, and the language they're in. shared uses the",
          "setting in plugins/Xena/config.yml, which every Xena plugin reads; anything else is",
          "this plugin's own."
        ],
        "choices": [],
        "entries": [
          {
            "path": "messages.language",
            "type": "language",
            "comment": [
              "The language players see messages in: auto for each player's own (their client's",
              "language setting), or one language for everyone, such as de or pt-BR."
            ],
            "default": "shared",
            "defaultText": "\"shared\"",
            "choices": [],
            "entries": []
          },
          {
            "path": "messages.default-language",
            "type": "language",
            "comment": [
              "The language of the console, and of players whose language has no file in lang/."
            ],
            "default": "shared",
            "defaultText": "\"shared\"",
            "choices": [],
            "entries": []
          },
          {
            "path": "messages.theme",
            "type": "section",
            "comment": [
              "The look every message shares, used in messages as tags: <prefix>, <highlight>,",
              "<success> and <error>. Colours are names (gray, gold) or hex (#B48CFF), with bold,",
              "italic, underlined, strikethrough or obfuscated if you like: <#B48CFF><bold>."
            ],
            "choices": [],
            "entries": [
              {
                "path": "messages.theme.prefix",
                "type": "string",
                "comment": [
                  "<prefix> starts the default messages. Make it your server's name, such as",
                  "\"<dark_gray>[<gradient:#B48CFF:#5EE08A>MyServer</gradient>]</dark_gray> \", or blank for none."
                ],
                "default": "shared",
                "defaultText": "\"shared\"",
                "choices": [],
                "entries": []
              },
              {
                "path": "messages.theme.base",
                "type": "style",
                "comment": [
                  "The colour of message text that has no tag of its own."
                ],
                "default": "shared",
                "defaultText": "\"shared\"",
                "choices": [],
                "entries": []
              },
              {
                "path": "messages.theme.highlight",
                "type": "style",
                "comment": [
                  "<highlight>: names and values, such as a player or a speed."
                ],
                "default": "shared",
                "defaultText": "\"shared\"",
                "choices": [],
                "entries": []
              },
              {
                "path": "messages.theme.success",
                "type": "style",
                "comment": [
                  "<success>: something turned on or done."
                ],
                "default": "shared",
                "defaultText": "\"shared\"",
                "choices": [],
                "entries": []
              },
              {
                "path": "messages.theme.error",
                "type": "style",
                "comment": [
                  "<error>: something refused or turned off."
                ],
                "default": "shared",
                "defaultText": "\"shared\"",
                "choices": [],
                "entries": []
              }
            ]
          }
        ]
      },
      {
        "path": "starting-coins",
        "type": "integer",
        "comment": [
          "Coins a player has before their first payment."
        ],
        "default": 100,
        "defaultText": "100",
        "choices": [],
        "min": 0,
        "entries": []
      },
      {
        "path": "pay-cooldown",
        "type": "duration",
        "comment": [
          "How long a player waits between payments."
        ],
        "default": "10s",
        "defaultText": "\"10s\"",
        "choices": [],
        "entries": []
      },
      {
        "path": "interest",
        "type": "section",
        "comment": [
          "Coins paid on every balance now and then."
        ],
        "choices": [],
        "entries": [
          {
            "path": "interest.enabled",
            "type": "boolean",
            "comment": [
              "Whether interest is paid."
            ],
            "default": true,
            "defaultText": "true",
            "choices": [],
            "entries": []
          },
          {
            "path": "interest.percent",
            "type": "integer",
            "comment": [
              "How much of each balance, in percent."
            ],
            "default": 1,
            "defaultText": "1",
            "choices": [],
            "min": 0,
            "max": 100,
            "entries": []
          },
          {
            "path": "interest.every",
            "type": "duration",
            "comment": [
              "How often."
            ],
            "default": "1h",
            "defaultText": "\"1h\"",
            "choices": [],
            "entries": []
          }
        ]
      }
    ]
  },
  "placeholders": [
    {
      "name": "balance",
      "description": "The player's balance.",
      "example": "120",
      "needsPlayer": true,
      "forms": {
        "PlaceholderAPI": "%xsample_balance%",
        "MiniPlaceholders": "<xsample_balance>",
        "Text Placeholder API": "%xsample:balance%"
      }
    },
    {
      "name": "richest",
      "description": "The most coins anyone has.",
      "example": "4,200",
      "needsPlayer": false,
      "forms": {
        "PlaceholderAPI": "%xsample_richest%",
        "MiniPlaceholders": "<xsample_richest>",
        "Text Placeholder API": "%xsample:richest%"
      }
    }
  ],
  "messages": [
    {
      "key": "core.pages.footer",
      "english": "<gray>Page <page> of <pages></gray><has_previous> <click:run_command:'<previous>'><hover:show_text:'<previous>'><highlight>« Previous</highlight></hover></click></has_previous><has_next> <click:run_command:'<next>'><hover:show_text:'<next>'><highlight>Next »</highlight></hover></click></has_next>",
      "comment": [
        "Under a long list in chat (/homes, /history, ...) when it has more than one page.",
        "<previous> and <next> are the list's command for those pages; what's inside",
        "<has_previous>...</has_previous> or <has_next>...</has_next> shows only when there's such a page."
      ],
      "placeholders": [
        "page",
        "pages",
        "previous",
        "next",
        "has_previous",
        "has_next"
      ]
    },
    {
      "key": "sample.paid",
      "english": "<prefix>You paid <highlight><player></highlight> <amount> coins.",
      "comment": [
        "After /pay."
      ],
      "placeholders": [
        "player",
        "amount"
      ]
    },
    {
      "key": "sample.broke",
      "english": "<prefix><error>You don't have <amount> coins.",
      "comment": [],
      "placeholders": [
        "amount"
      ]
    }
  ],
  "events": [
    {
      "key": "xsample:coins_paid",
      "className": "co.xenastudios.core.sample.CoinsPaidEvent",
      "description": "A player is about to pay another.",
      "cancellable": true,
      "since": "1.0.0"
    },
    {
      "key": "xsample:interest_paid",
      "className": "co.xenastudios.core.sample.InterestPaidEvent",
      "description": "Interest was paid on every balance.",
      "cancellable": false,
      "since": "1.0.0"
    }
  ]
}
