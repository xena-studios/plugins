{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["before 6am on monday"],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "The oldest Paper the plugins support. Raising it drops every server still on it, so it's changed by hand. The newest Paper is tracked by .github/workflows/minecraft.yml.",
      "matchPackageNames": ["io.papermc.paper:paper-api"],
      "enabled": false
    },
    {
      "description": "Small updates merge themselves once CI passes; majors wait for a review.",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "matchManagers": ["gradle", "gradle-wrapper"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Gradle dependencies"
    },
    {
      "matchManagers": ["npm"],
      "matchFileNames": ["docs/**"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "docs site"
    }
  ]
}
