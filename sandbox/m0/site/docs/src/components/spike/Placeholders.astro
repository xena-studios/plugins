---
// Placeholders, written the way each placeholder plugin expects them.
import type { Placeholder } from "./manifest";

interface Props {
  placeholders: Placeholder[];
}
const { placeholders } = Astro.props;
const plugins = [...new Set(placeholders.flatMap((p) => Object.keys(p.forms)))];
---
<table class="ref-placeholders">
  <thead>
    <tr><th>Placeholder</th><th>Shows</th><th>Example</th></tr>
  </thead>
  <tbody>
    {placeholders.map((p) => (
      <tr>
        <td>
          {plugins.map((name) => p.forms[name] && <div><code>{p.forms[name]}</code> <span class="ref-hint">{name}</span></div>)}
        </td>
        <td>{p.description}</td>
        <td><code>{p.example}</code></td>
      </tr>
    ))}
  </tbody>
</table>
