{
  "schemaVersion": 1,
  "id": "xvote",
  "version": "${version}",
  "name": "xVote",
  "description": "Votes in. Rewards out. Server-side: players install nothing.",
  "authors": ["Xena Studios"],
  "contact": {
    "homepage": "https://plugins.xenastudios.co/xvote/",
    "sources": "https://github.com/xena-studios/plugins",
    "issues": "https://github.com/xena-studios/plugins/issues"
  },
  "license": "GPL-3.0-only",
  "environment": "server",
  "entrypoints": {
    "main": [
      { "adapter": "kotlin", "value": "co.xenastudios.xvote.fabric.XVoteMod" }
    ]
  },
  "depends": {
    "fabricloader": "${loader}",
    "minecraft": "${minecraft}",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=${flk}"
  }
}
